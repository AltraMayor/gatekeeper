// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.

[
  {
    "label": "Gatekeeper: Build",
    "command": "make",
    "args": ["-j"],
    // Which edited buffers to save before running the task:
    // * `none` — don't save any buffers (default)
    // * `current` — save currently active buffer only
    // * `all` — save all edited buffers
    "save": "all"
  },
  {
    "label": "Gatekeeper: Clean",
    "command": "make",
    "args": ["clean"]
  },
  {
    "label": "Gatekeeper: Start lldb-server",
    "command": "$ZED_WORKTREE_ROOT/.zed/start-lldb-server.sh"
  },
  {
    "label": "Gatekeeper: Stop lldb-server",
    "command": "sudo killall lldb-server || true"
  }
]
